# 本地开发环境配置

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# 数据库配置 - 使用 SQLite 本地数据库（无需安装 PostgreSQL）
DB_TYPE=sqlite
DB_PATH=./data/task_server.db

# 如果您已安装 PostgreSQL，可以取消注释以下配置
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=task_server
# DB_SSLMODE=disable

# Redis 配置 - 可选，不启用 Redis 也能正常运行
# REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# JWT 配置
JWT_SECRET=dev_jwt_secret_key_123456789
JWT_EXPIRATION_HOURS=24

# AI 服务配置 - 可选
# AI_API_KEY=your_ai_api_key_here
# AI_BASE_URL=https://api.openai.com/v1

# 天气服务配置 - 可选
# WEATHER_API_KEY=your_amap_api_key_here

# 日志配置
LOG_LEVEL=debug
LOG_OUTPUT=stdout